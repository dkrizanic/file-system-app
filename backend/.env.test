# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# The db-test compose service (root compose.test.yaml, `test` profile). Host
# port 5433 mirrors it for host-side psql; the app container reaches it by
# service name on the compose network. The test env reads this instead of
# DATABASE_URL, so the container's dev value cannot leak into tests.
###> doctrine/doctrine-bundle ###
TEST_DATABASE_URL="postgresql://app:app@db-test:5432/app_test?serverVersion=18&charset=utf8"
###< doctrine/doctrine-bundle ###
